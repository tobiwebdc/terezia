---
layout: layouts/page.njk
permalink: /index.html
---
{% import "product-card.njk" as cards %}

<!-- HERO — layout přímo odkazuje na logo: pruhy nahoře/dole, krémový střed -->
<section id="hero" class="relative min-h-screen flex flex-col overflow-hidden bg-cream">
  <div class="stripe-band h-14 sm:h-20"></div>

  <div class="relative flex-1 flex items-center justify-center text-center px-6 py-16">
    <div>
      <p class="label-caps text-ink/50 mb-6">{{ hero.eyebrow }}</p>
      <h1 class="font-script text-coral text-5xl sm:text-7xl md:text-8xl leading-none">
        {{ hero.title }}
      </h1>
      <p class="font-body italic text-lg sm:text-xl mt-6 text-ink/70">{{ hero.subtitle }}</p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#produkty" class="label-caps px-8 py-3 bg-coral text-cream hover:bg-coral/90 transition-colors">
          {{ hero.ctaPrimary }}
        </a>
        <a href="#kontakt" class="label-caps px-8 py-3 border border-coral text-coral hover:bg-coral/10 transition-colors">
          {{ hero.ctaSecondary }}
        </a>
      </div>
    </div>
  </div>

  <div class="stripe-band h-14 sm:h-20"></div>
</section>

<!-- O MNĚ -->
<section id="o-mne" class="bg-cream py-24 sm:py-32">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
    <div class="deco-frame p-2">
      <div class="aspect-[3/4] bg-sage/40 flex flex-col items-center justify-center text-ink gap-4 overflow-hidden">
        {% if about.image %}
          <img src="{{ about.image | url }}" alt="{{ about.heading }}" class="w-full h-full object-cover">
        {% else %}
          <img src="{{ '/assets/favicon.svg' | url }}" class="w-16 h-16 text-coral" alt="">
          <p class="label-caps text-ink/60 text-center px-8">Portrét ateliéru<br/>doplníme fotografií</p>
        {% endif %}
      </div>
    </div>

    <div>
      <p class="label-caps text-coral mb-4">{{ about.eyebrow }}</p>
      <h2 class="font-display font-semibold text-3xl sm:text-4xl mb-6">{{ about.heading }}</h2>
      <p class="font-body text-lg leading-relaxed text-ink/80 mb-4 text-justify">{{ about.text }}</p>
      <p class="font-body text-lg leading-relaxed text-ink/80 mb-8 text-justify">{{ about.text2 }}</p>
      <blockquote class="border-l-2 border-mustard pl-6 font-script text-2xl text-coral">
        {{ about.quote }}
      </blockquote>

      <div class="flex justify-center gap-5 text-cream/60 mb-4 pt-10">
      {% if social.facebook %}
        <a href="{{ social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook" class="inline-block transition-transform duration-200 hover:scale-110">
          <img src="{{ '/assets/svg/link-facebook.svg' | url }}" class="w-10 h-10" alt="Facebook">
        </a>
      {% endif %}
      {% if social.instagram %}
        <a href="{{ social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="inline-block transition-transform duration-200 hover:scale-110">
          <img src="{{ '/assets/svg/link-instagram.svg' | url }}" class="w-10 h-10" alt="Instagram">
        </a>
      {% endif %}
      {% if social.fler %}
        <a href="{{ social.fler }}" target="_blank" rel="noopener" aria-label="Fler" class="inline-block transition-transform duration-200 hover:scale-110">
          <img src="{{ '/assets/svg/link-fler.svg' | url }}" class="w-10 h-10" alt="Fler">
        </a>
      {% endif %}
    </div>

    </div>
  </div>
</section>

<!-- DIVIDER — pruhy z loga jako opakující se signature prvek -->
<div class="stripe-band h-8"></div>

<!-- VÝROBA -->
<section id="vyroba" class="bg-brown text-cream py-24 sm:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="label-caps text-mustard mb-4">{{ gallery.eyebrow }}</p>
      <h2 class="font-display font-semibold text-3xl sm:text-4xl">{{ gallery.heading }}</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-10">
      <div class="border-t-2 border-coral pt-6">
        <p class="label-caps text-coral mb-3">{{ gallery.caption }}</p>
        <p class="font-body text-cream/80 leading-relaxed text-justify">{{ gallery.text }}</p>
      </div>
      <div class="border-t-2 border-mustard pt-6">
        <p class="label-caps text-mustard mb-3">{{ gallery.caption1 }}</p>
        <p class="font-body text-cream/80 leading-relaxed text-justify">{{ gallery.text1 }}</p>
      </div>
      <div class="border-t-2 border-sage pt-6">
        <p class="label-caps text-sage mb-3">{{ gallery.caption2 }}</p>
        <p class="font-body text-cream/80 leading-relaxed text-justify">{{ gallery.text2 }}</p>
      </div>
    </div>
  </div>
</section>

<!-- DIVIDER -->
<div class="stripe-band h-8"></div>

<!-- PRODUKTY -->
<section id="produkty" class="bg-cream py-24 sm:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-6">
      <p class="label-caps text-coral mb-4">{{ productsIntro.eyebrow }}</p>
      <h2 class="font-display font-semibold text-2xl sm:text-3xl">{{ productsIntro.heading }}</h2>
      <p class="font-body text-ink/70 mt-3 max-w-xl mx-auto text-justify">{{ productsIntro.text }}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 mt-16">
      {% for product in collections.productsKolekce %}
        {{ cards.productCard(product.data, loop.index0, product.data.sold) }}
      {% endfor %}
    </div>

    <div class="text-center mt-24 mb-6">
      <h2 class="font-display font-semibold text-2xl sm:text-3xl">{{ productsIntro.heading1 }}</h2>
      <p class="font-body text-ink/70 mt-3 max-w-xl mx-auto">{{ productsIntro.text1 }}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 mt-16">
      {% for product in collections.productsInspirace %}
        {{ cards.productCard(product.data, loop.index0 + 1, product.data.sold) }}
      {% endfor %}
    </div>
  </div>
</section>

<!-- KONTAKT -->
<section id="kontakt" class="relative bg-coral text-cream py-24 sm:py-32 overflow-hidden">
  <div class="relative max-w-3xl mx-auto px-6">
    <div class="text-center mb-12">
      <p class="label-caps text-mustard mb-4">{{ contact.eyebrow }}</p>
      <h2 class="font-display font-semibold text-3xl sm:text-4xl mb-6">{{ contact.heading }}</h2>
      <p class="font-body text-lg text-cream/90">{{ contact.text }}</p>
    </div>

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <form id="contact-form" class="border border-cream/40 p-8 sm:p-10 space-y-6">
      <input type="hidden" name="form-name" value="poptavka" />
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <label class="label-caps block mb-2" for="name">Jméno</label>
          <input id="name" name="name" type="text" required class="w-full bg-transparent border-b border-cream/40 py-2 focus:outline-none focus:border-mustard" />
        </div>
        <div>
          <label class="label-caps block mb-2" for="email">E-mail</label>
          <input id="email" name="email" type="email" required class="w-full bg-transparent border-b border-cream/40 py-2 focus:outline-none focus:border-mustard" />
        </div>
      </div>
      <div>
        <label class="label-caps block mb-2" for="message">Zpráva</label>
        <textarea id="message" name="message" rows="4" required class="w-full bg-transparent border-b border-cream/40 py-2 focus:outline-none focus:border-mustard resize-none"></textarea>
      </div>
      <input type="text" name="website" style="position:absolute; left:-9999px" tabindex="-1" autocomplete="off" />
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAEXtY5ZqmzeYeMbm"></div>
      <div class="text-center pt-2">
        <button type="submit" class="label-caps px-10 py-3 bg-mustard text-ink hover:bg-mustard/90 transition-colors">
          Odeslat poptávku
        </button>
        <p id="form-status"></p>
      </div>
    </form>

    <div class="text-center mt-10 label-caps text-cream/80 space-y-1">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4">
        <a href="mailto:{{ contact.email }}" class="inline-flex items-center gap-2 text-white hover:text-mustard transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z"/>
          </svg>
          <span>{{ contact.email }}</span>
        </a>

        <span class="hidden sm:inline text-white/40">·</span>

        <a href="tel:{{ contact.phone }}" class="inline-flex items-center gap-2 text-white hover:text-mustard transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
          </svg>
          <span>{{ contact.phone }}</span>
        </a>
      </div>
      
      <p>{{ contact.address }}</p>
      <p class="text-cream/60">{{ contact.ico }}</p>
    </div>
  </div>
</section>
