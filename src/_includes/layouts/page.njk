<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or site.meta.title }}</title>
  <meta name="description" content="{{ description or site.meta.description }}" />
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Fredoka:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/base.css" />
</head>
<body class="bg-cream text-ink antialiased">
  
  <!-- NAV -->
  <header id="site-nav" class="fixed top-0 inset-x-0 z-50 bg-cream/95 border-b border-coral/20 transition-shadow duration-300">
    <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 text-coral">
        <img src="/assets/favicon.svg" class="w-6 h-6">
        <span class="font-script text-xl">Klobouky Terezia</span>
      </a>
      <div class="flex items-center gap-6">
        <nav class="hidden sm:flex gap-8 label-caps text-ink/70">
          <a href="/#o-mne" class="hover:text-coral transition-colors">O mně</a>
          <a href="/#vyroba" class="hover:text-coral transition-colors">Výroba</a>
          <a href="/#produkty" class="hover:text-coral transition-colors">Produkty</a>
          <a href="/#kontakt" class="hover:text-coral transition-colors">Kontakt</a>
        </nav>
      </div>
    </div>
  </header>

  {{ content | safe }}

  <!-- FOOTER -->
  <div class="stripe-band h-6"></div>
  <footer class="bg-ink text-cream/50 py-10 text-center">
    <img src="/assets/favicon.svg" height="24" width="24"  class="w-5 h-5 mx-auto mb-4 text-coral">
    <div class="flex justify-center gap-5 label-caps text-cream/60 mb-4">
      <a href="{{ site.social_links[0].facebook }}" target="_blank" rel="noopener" class="hover:text-coral transition-colors">Facebook</a>
      <a href="{{ site.social_links[0].instagram }}" target="_blank" rel="noopener" class="hover:text-coral transition-colors">Instagram</a>
      <a href="{{ site.social_links[0].fler }}" target="_blank" rel="noopener" class="hover:text-coral transition-colors">Fler</a>
    </div>
    <p class="label-caps text-xs">{{ site.footer.text }} · © {{ currentYear }} {{ site.hero.title }}</p>
  </footer>

  <!-- MODAL: prohlížení fotek produktu (hlavní obrázek + náhledy, šipky, detail) -->
  <div id="product-modal" class="fixed inset-0 z-[100] hidden bg-ink/90 p-4 sm:p-8 overflow-y-auto items-start sm:items-center justify-center">
    <div class="max-w-4xl w-full bg-cream relative mx-auto my-auto">
      <button id="modal-close" type="button" aria-label="Zavřít" class="absolute -top-10 right-0 sm:top-4 sm:right-4 text-cream sm:text-ink/60 hover:text-coral text-3xl leading-none z-10">&times;</button>

      <div class="grid sm:grid-cols-2">
        <div class="relative bg-ink/5">
          <img id="modal-main-img" src="" alt="" class="w-full aspect-[4/5] object-cover" />
          <button id="modal-prev" type="button" aria-label="Předchozí fotka" class="absolute left-2 top-1/2 -translate-y-1/2 text-cream bg-ink/50 hover:bg-ink/70 w-9 h-9 rounded-full flex items-center justify-center text-xl">&#8249;</button>
          <button id="modal-next" type="button" aria-label="Další fotka" class="absolute right-2 top-1/2 -translate-y-1/2 text-cream bg-ink/50 hover:bg-ink/70 w-9 h-9 rounded-full flex items-center justify-center text-xl">&#8250;</button>
          <div id="modal-thumbs" class="flex gap-2 p-3"></div>
        </div>
        <div class="p-6 sm:p-8 overflow-y-auto max-h-[80vh]">
          <h3 id="modal-name" class="font-display font-semibold text-2xl mb-2"></h3>
          <p id="modal-price" class="label-caps text-coral mb-4"></p>
          <p id="modal-desc" class="font-body text-ink/80 leading-relaxed mb-5 whitespace-pre-line"></p>
          <dl id="modal-specs" class="text-sm space-y-2 text-ink/70 border-t border-ink/10 pt-4"></dl>
        </div>
      </div>
    </div>
  </div>
  <script src="/assets/js/main.js"></script>
</body>
</html>
