<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or meta.title }}</title>
  <meta name="description" content="{{ description or meta.description }}" />
  <link rel="icon" type="image/x-icon" href="{{ '/assets/favicon.ico' | url }}">

  <link rel="preload" href="{{ '/assets/fonts/nunito-v32-latin_latin-ext-600.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/nunito-v32-latin_latin-ext-regular.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/kaushan-script-v19-latin_latin-ext-regular.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/quicksand-v37-latin_latin-ext-300.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/quicksand-v37-latin_latin-ext-700.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/quicksand-v37-latin_latin-ext-regular.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/montserrat-v31-latin-regular.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/inter-v20-latin_latin-ext-regular.woff2' | url }}" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="{{ '/assets/css/base.css' | url }}" />
</head>
<body class="bg-cream text-ink antialiased">
  
  <!-- NAV -->
  <header id="site-nav" class="fixed top-0 inset-x-0 z-50 bg-cream/95 border-b border-coral/20 transition-shadow duration-300">
  <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
    <a href="{{ '/' | url }}" class="flex items-center gap-2 text-coral">
      <img src="{{ '/assets/favicon.svg' | url }}" class="w-6 h-6">
      <span class="font-script text-xl">Klobouky Terezia</span>
    </a>

    <div class="flex items-center gap-6">
      <nav class="hidden sm:flex gap-8 label-caps text-ink/70">
        <a href="{{ '/' | url }}#o-mne" class="hover:text-coral transition-colors">O mně</a>
        <a href="{{ '/' | url }}#vyroba" class="hover:text-coral transition-colors">Výroba</a>
        <a href="{{ '/' | url }}#produkty" class="hover:text-coral transition-colors">Produkty</a>
        <a href="{{ '/' | url }}#kontakt" class="hover:text-coral transition-colors">Kontakt</a>
      </nav>

      <button
        id="nav-toggle"
        type="button"
        class="sm:hidden text-coral"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Otevřít menu"
      >
        <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
          <line x1="6" y1="6" x2="18" y2="18"/>
          <line x1="18" y1="6" x2="6" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden sm:hidden flex-col gap-1 px-6 pb-4 label-caps text-ink/70">
    <a href="{{ '/' | url }}#o-mne" class="block py-2 hover:text-coral transition-colors">O mně</a>
    <a href="{{ '/' | url }}#vyroba" class="block py-2 hover:text-coral transition-colors">Výroba</a>
    <a href="{{ '/' | url }}#produkty" class="block py-2 hover:text-coral transition-colors">Produkty</a>
    <a href="{{ '/' | url }}#kontakt" class="block py-2 hover:text-coral transition-colors">Kontakt</a>
  </nav>
</header>

<script>
  (function () {
    const toggle = document.getElementById('nav-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    toggle.addEventListener('click', () => {
      const isOpen = mobileNav.classList.toggle('flex');
      mobileNav.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    // zavřít menu po kliknutí na odkaz (užitečné pro jednostránkové kotvy)
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        mobileNav.classList.remove('flex');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>

  {{ content | safe }}

  <!-- FOOTER -->
  <div class="stripe-band h-6"></div>
  <footer class="bg-brown text-cream/50 py-10 text-center">
    <div class="flex justify-center gap-5 text-cream/60 mb-4">
      {% if social.facebook %}
      <a href="{{ social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-facebook transition-colors">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.1 15.95 2 14.66 2 11.96 2 10 3.66 10 6.7v2.8H7v4h3V22h4v-8.5Z"/></svg>
      </a>
      {% endif %}
      {% if social.instagram %}
      <a href="{{ social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-coral transition-colors">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1"/></svg>
      </a>
      {% endif %}
      {% if social.fler %}
      <a href="{{ social.fler }}" target="_blank" rel="noopener" aria-label="Fler" class="hover:text-fler transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"  fill="currentColor" stroke="none" >
          <path d="M 18.16,3.01 C 17.77,2.63 17.21,2.4 16.47,2.4 C 14.73,2.4 13.5,3.45 12.49,6.44 L 12.24,7.16 L 11.97,7.92 C 11.76,8.55 11.43,8.8 10.73,8.8 L 9.4,8.8 C 8.86,8.8 8.54,9.21 8.35,9.72 C 8.19,10.19 8.33,10.53 8.8,10.53 L 10.14,10.53 C 10.74,10.53 10.98,10.85 10.8,11.41 L 10.7,11.73 L 10.6,11.98 L 8.98,16.81 C 8.52,18.15 7.94,19.49 7.23,19.49 C 7.14,19.49 7.08,19.45 7.03,19.39 C 6.83,19.2 6.61,19.25 6.43,19.39 C 6.07,19.66 5.78,20.23 5.73,20.45 C 5.7,20.6 5.72,20.85 5.85,20.99 C 6.24,21.37 6.8,21.6 7.54,21.6 C 9.1,21.6 10.19,20.84 11.13,18.51 L 12.07,15.74 L 12.35,14.95 C 12.36,14.91 12.37,14.87 12.39,14.83 L 13.08,12.82 L 13.17,12.58 L 13.56,11.41 C 13.77,10.78 14.1,10.53 14.8,10.53 L 15.33,10.51 C 15.86,10.51 16.14,10.23 16.33,9.73 C 16.49,9.26 16.4,8.78 15.92,8.78 L 15.4,8.8 C 14.8,8.8 14.58,8.52 14.77,7.96 L 15.01,7.22 L 15.02,7.19 C 15.48,5.85 16.06,4.52 16.77,4.52 C 16.86,4.52 16.93,4.55 16.98,4.61 C 17.18,4.8 17.44,4.74 17.63,4.59 C 17.84,4.43 18.18,3.78 18.25,3.56 C 18.3,3.37 18.3,3.14 18.16,3.01 Z" />
        </svg>  
      </a>
      {% endif %}
    </div>

    <div class="flex flex-col items-center sm:grid sm:grid-cols-[1fr_auto_1fr] sm:items-center justify-items-center gap-2 label-caps text-xs">
      <span class="text-nowrap sm:justify-self-end">{{ footer.text }}</span>
      <img src="{{ '/assets/favicon.svg' | url }}" height="24" width="24" class="w-5 h-5 text-coral">
      <span class="text-nowrap sm:justify-self-start">© {{ currentYear }} {{ hero.title }}</span>
    </div>
  
  </footer>

  <!-- MODAL: prohlížení fotek produktu (hlavní obrázek + náhledy, šipky, detail) -->
  <div id="product-modal" class="fixed inset-0 z-[100] hidden bg-ink/90 p-4 sm:p-8 overflow-y-auto items-start sm:items-center justify-center">
    <div class="max-w-4xl w-full bg-cream relative mx-auto my-auto">
      <button id="modal-close" type="button" aria-label="Zavřít" class="absolute top-2 right-2 sm:top-4 sm:right-4 z-10 flex items-center justify-center w-9 h-9 rounded-full bg-ink/60 text-cream hover:bg-coral hover:text-cream transition-colors">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="2" y1="2" x2="14" y2="14"/>
          <line x1="14" y1="2" x2="2" y2="14"/>
        </svg>
      </button>
      <div class="grid sm:grid-cols-2">
        <div class="flex bg-ink/5">
          <div id="modal-thumbs" class="flex flex-col gap-2 p-3 overflow-y-auto max-h-[70vh] sm:max-h-[80vh]"></div>
          <div class="relative flex-1">
            <img id="modal-main-img" src="" alt="" class="w-full h-full aspect-[4/5] object-cover" />
            <button id="modal-prev" type="button" aria-label="Předchozí fotka" class="absolute left-2 top-1/2 -translate-y-1/2 text-cream bg-ink/50 hover:bg-ink/70 w-9 h-9 rounded-full flex items-center justify-center text-xl">&#8249;</button>
            <button id="modal-next" type="button" aria-label="Další fotka" class="absolute right-2 top-1/2 -translate-y-1/2 text-cream bg-ink/50 hover:bg-ink/70 w-9 h-9 rounded-full flex items-center justify-center text-xl">&#8250;</button>
          </div>
        </div>
        <div class="p-6 sm:p-8 overflow-y-auto max-h-[80vh]">
          <h3 id="modal-name" class="font-display font-semibold text-2xl mb-2"></h3>
          <p id="modal-price" class="label-caps text-xl text-coral mb-4"></p>
          <p id="modal-desc" class="font-body text-ink/80 leading-relaxed mb-5 whitespace-pre-line"></p>
          <div class="border-t border-ink/10 pt-4">
            <table id="modal-specs" class="text-sm text-ink/70 w-full border-collapse">
              <tbody></tbody>
            </table>
          </div>
          <div class="flex">
            <button type="button" id="modal-poptat" class="label-caps px-6 py-2 border border-coral text-coral hover:bg-coral hover:text-cream transition-colors mt-5  w-full">
              Poptat tento produkt
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="{{ '/assets/js/main.js' | url }}"></script>
</body>
</html>
