---
layout: layouts/base.njk
---
<article class="product">
  <h1>{{ name | default(title) }}</h1>

  {% if images and images.length %}
    <div class="product__gallery">
      {% for img in images %}
        <img src="{{ img }}" alt="{{ name | default(title) }}">
      {% endfor %}
    </div>
  {% endif %}

  {% if price %}<p class="product__price">{{ price }}</p>{% endif %}
  {% if category %}<p class="product__category">{{ category }}</p>{% endif %}

  <div class="product__description">
    {{ content | safe }}
  </div>
</article>
