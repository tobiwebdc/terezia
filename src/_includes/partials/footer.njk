<footer class="site-footer">
  <p>&copy; {% currentYear %} {{ site.site_name | default("") }}</p>

  {% if site.contact_email %}
    <p><a href="mailto:{{ site.contact_email }}">{{ site.contact_email }}</a></p>
  {% endif %}
  {% if site.phone %}<p>{{ site.phone }}</p>{% endif %}
  {% if site.address %}<p>{{ site.address }}</p>{% endif %}

  {% if site.social_links and site.social_links.length %}
    <ul class="social-links">
      {% for link in site.social_links %}
        <li><a href="{{ link.url }}">{{ link.label | default(link.url) }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}
</footer>
